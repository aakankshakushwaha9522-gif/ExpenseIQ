{
  "name": "expenseiq",
  "version": "3.0.0",
  "description": "ExpenseIQ — expense tracker with its own login system, live sync and a Gemini assistant. No third-party dependencies.",
  "main": "server/index.js",
  "private": true,
  "engines": { "node": ">=20.12" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node scripts/check-env.js",
    "test": "node --test --test-reporter=spec \"tests/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec tests/e2e/ui.e2e.js"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "license": "MIT"
}
