{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run ExpenseIQ server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "🧪 Run unit tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "tests/"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🌐 Open app in Chrome (server must be running)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/public"
    }
  ],
  "compounds": [
    {
      "name": "▶ Server + Chrome",
      "configurations": ["▶ Run ExpenseIQ server", "🌐 Open app in Chrome (server must be running)"],
      "stopAll": true
    }
  ]
}
