{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check configuration",
      "type": "shell",
      "command": "npm run check",
      "problemMatcher": []
    },
    {
      "label": "Start dev server",
      "type": "shell",
      "command": "npm run check; npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^$",
          "endsPattern": "ExpenseIQ running"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "npm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run browser e2e tests",
      "type": "shell",
      "command": "npm run test:e2e",
      "group": "test",
      "problemMatcher": []
    }
  ]
}